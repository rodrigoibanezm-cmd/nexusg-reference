{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reference.nexusg.cl/contracts/evidence.schema.json",
  "title": "NexusG Evidence",
  "description": "Referencia trazable a una observación, declaración, cálculo, clasificación, inferencia o recomendación.",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "tenant_id", "source", "modality", "observed_at"],
  "properties": {
    "evidence_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id"],
      "properties": {
        "source_type": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "entity_id": { "type": "string" },
        "document_id": { "type": "string" },
        "location": { "type": "string" }
      }
    },
    "modality": {
      "type": "string",
      "enum": ["recorded_fact", "statement", "calculation", "semantic_classification", "inference", "recommendation"]
    },
    "title": { "type": "string" },
    "excerpt": { "type": "string" },
    "value": {},
    "metadata": { "type": "object", "additionalProperties": true },
    "observed_at": { "type": "string", "format": "date-time" },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "normalization_version": { "type": "string" },
        "engine_version": { "type": "string" },
        "policy_version": { "type": "string" },
        "contract_version": { "type": "string" },
        "execution_id": { "type": "string" }
      }
    },
    "access_scope": { "type": "object", "additionalProperties": true }
  }
}
