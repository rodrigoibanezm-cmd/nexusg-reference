{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reference.nexusg.cl/contracts/pressure-signal.schema.json",
  "title": "NexusG PressureSignal",
  "description": "Situación operacional persistente que requiere atención, seguimiento o decisión.",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal_id", "signal_key", "tenant_id", "dimension", "status", "priority", "title", "summary", "why_it_matters", "evidence_refs", "created_at", "updated_at"],
  "properties": {
    "signal_id": { "type": "string", "minLength": 1 },
    "signal_key": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "dimension": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "monitoring", "resolved", "dismissed"] },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "score": { "type": "number" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "why_it_matters": { "type": "string", "minLength": 1 },
    "recommended_action": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "context": { "type": "object", "additionalProperties": true },
    "policy_version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
